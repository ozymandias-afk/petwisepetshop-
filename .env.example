# Public website origin used for absolute product links and social previews
NEXT_PUBLIC_SITE_URL=https://your-live-domain.example

# Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key

# Resend (optional order confirmation and shop notification emails)
RESEND_API_KEY=re_your_key
ORDER_EMAIL_FROM=PetWise <orders@your-verified-domain.example>
SHOP_NOTIFICATION_EMAIL=shop@example.com

# Add actual payment details before accepting bank-transfer orders
NEXT_PUBLIC_CLIQ_ALIAS=your-cliq-alias
NEXT_PUBLIC_BANK_IBAN=your-iban
NEXT_PUBLIC_BANK_ACCOUNT_NAME=account-holder-name

# Payment provider integration (server-only; not active until implemented)
PAYMENT_PROVIDER=
PAYMENT_PROVIDER_PUBLIC_KEY=
PAYMENT_PROVIDER_SECRET_KEY=
PAYMENT_PROVIDER_WEBHOOK_SECRET=
